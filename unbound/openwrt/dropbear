# ==============================================================================
# OpenWRT / FriendlyWrt - Configuração do Servidor SSH (Dropbear)
# Localização: /etc/config/dropbear
# ==============================================================================

config dropbear 'main'
        # Habilita o serviço SSH
        option enable '1'

        # Porta padrão do SSH (22):
        option Port '22'

        # Permite autenticação por senha para usuários normais
        option PasswordAuth 'off'

        # Permite login do usuário root com senha
        # RECOMENDAÇÃO DE SEGURANÇA: Após configurar chave pública SSH (~/.ssh/authorized_keys),
        # você pode alterar esta opção para 'off' para impedir ataques de força bruta.
        option RootPasswordAuth 'off'

        # Permite login apenas por interfaces específicas (restringe à LAN):
        option Interface 'lan'

        # Arquivo de banner exibido antes do login (opcional):
        # option BannerFile '/etc/banner'
