# ==============================================================================
# OpenWRT / FriendlyWrt - Configuração do Irqbalance
# Roteador: NanoPi R3S (Processador Rockchip RK3568 Quad-Core Cortex-A55)
# Localização no roteador: /etc/config/irqbalance
# ==============================================================================
# Status: DESATIVADO (Substituído por Afinidade Estática SMP no /etc/rc.local)
#
# Por que a afinidade estática é superior ao irqbalance no NanoPi R3S:
# 1. O NanoPi R3S tem interfaces físicas fixas e determinísticas:
#    - eth0 (WAN PPPoE): fixada no CPU1 (máscara 2) + RPS rx-0 na CPU1
#    - eth1 (LAN Gigabit): fixada no CPU2 (máscara 4)
#    - xhci-hcd (Wi-Fi USB 5G Comfast + 2.4G Edup): fixada no CPU3 (máscara 8)
#    - CPU0: 100% livre para Sistema Operacional, Daemons e Containers LXC
# 2. O daemon irqbalance em roteadores de poucas interfaces causa "cache thrashing"
#    e agrupa dinamicamente a WAN (eth0) e o Wi-Fi USB (xhci) no mesmo núcleo (CPU3),
#    deixando a CPU1 ociosa e sobrecarregando a CPU3.
# 3. As afinidades estáticas são aplicadas de forma determinística no /etc/rc.local.
# ==============================================================================

config irqbalance 'irqbalance'
        # Desativado para priorizar a afinidade estática via /etc/rc.local:
        option enabled '0'

        # Intervalo em segundos entre as análises e rebalanceamento (padrão: 10s):
        option interval '10'

        # Nível de cache mais profundo (1 = núcleos individuais do RK3568):
        option deepestcache '1'

        # Caso seja reativado no futuro, banir CPU0 (Daemons/LXC) e CPU3 (Wi-Fi USB):
        option banned_cpulist '0,3'
        list banirq '42'
