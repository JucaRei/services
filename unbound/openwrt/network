config interface 'loopback'
        option device 'lo'
        option proto 'static'
        option ipaddr '127.0.0.1'
        option netmask '255.0.0.0'

config globals 'globals'
        option ula_prefix 'fd00:ab:cd::/48'
        option packet_steering '1'
        option steering_flows '128'

config device
        option name 'eth0'
        option macaddr 'XXS:XX:XX:XX:XX:XX'

config interface 'wan'
        option device 'eth0'
        option proto 'pppoe'
        option username 'guest'
        option password 'guest'
        option ipv6 'auto'

config interface 'wan6'
        option device 'eth0'
        option proto 'dhcpv6'

config device
        option name 'br-lan'
        option type 'bridge'
        list ports 'eth1'

config device
        option name 'eth1'
        option macaddr 'XX:XX:XX:XX:XX:XX'

config interface 'lan'
        option device 'br-lan'
        option proto 'static'
        option ipaddr '10.10.10.1'
        option netmask '255.255.255.0'
        option ip6assign '60'
        option peerdns '0'
        list dns '10.10.10.25'
        list dns '10.10.10.26'
        list dns '1.1.1.1'              # Fallback seguro para o OpenWrt caso os containers LXC estejam offline no boot