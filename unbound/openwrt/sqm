# ==============================================================================
# OpenWRT / FriendlyWrt - SQM QoS (Smart Queue Management com CAKE)
# Otimizado para NanoPi R3S (RK3568) - Conexão PPPoE: 150M Down / 41M Up
# Localização no roteador: /etc/config/sqm
# ==============================================================================

config queue 'wan'
        # Habilita o gerenciamento inteligente de filas:
        option enabled '1'

        # Interface lógica do PPPoE:
        option interface 'pppoe-wan'

        # Velocidade de Download configurada em kbps:
        option download '150000'

        # Velocidade de Upload configurada em kbps:
        option upload '41000'

        # Algoritmo de gerenciamento de fila: CAKE (Piece of Cake)
        option qdisc 'cake'
        option script 'piece_of_cake.qos'

        # Camada de enlace (Ethernet sobre FTTH):
        option linklayer 'ethernet'

        # Compensação de Overhead para encapsulamento PPPoE:
        option overhead '44'

        # Otimizações de Qdisc Ingress/Egress (NAT + Filtragem de ACKs TCP redundantes):
        option iqdisc_opts 'nat'
        option eqdisc_opts 'nat ack-filter'

        # Desativa logs excessivos no sistema:
        option verbosity '0'
        option debug_logging '0'
