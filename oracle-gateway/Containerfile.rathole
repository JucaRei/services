FROM docker.io/library/debian:bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates \
    && ARCH=$(uname -m) \
    && URL=$(curl -sSL https://api.github.com/repos/rapiz1/rathole/releases/latest \
       | grep -oE "https://[^\"]+${ARCH}-unknown-linux-(musl|gnu)\.zip" | head -n 1) \
    && echo "Downloading: ${URL}" \
    && curl -sSL "${URL}" -o /tmp/rathole.zip \
    && unzip /tmp/rathole.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/rathole

FROM docker.io/library/debian:bookworm-slim
COPY --from=builder /usr/local/bin/rathole /usr/local/bin/rathole
ENTRYPOINT ["/usr/local/bin/rathole"]
