# ==============================================================================
# Oracle Cloud Gateway (OCI) - Variáveis de Ambiente (.env)
# ==============================================================================

# Hash bcrypt da senha de administração da interface Web do WireGuard (wg-easy)
# Gere no terminal via:
#   docker run --rm -it ghcr.io/wg-easy/wg-easy wgpw 'SUA_SENHA_AQUI'
#
# ATENÇÃO: No arquivo .env ou docker-compose, se o hash gerado contiver caracteres '$',
# substitua cada '$' por '$$' para evitar interpolação indevida pelo Docker Compose.
# Exemplo: WG_PASSWORD_HASH='$$2a$$12$$e8N...'
WG_PASSWORD_HASH='<GERAR_HASH_BCRYPT_PASSWORD>'
