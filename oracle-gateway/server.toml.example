# ==============================================================================
# Rathole Server Configuration (Oracle Cloud Gateway - OCI)
# ==============================================================================

[server]
bind_addr = "0.0.0.0:2333"
default_token = "<TOKEN_64_HEX>"

[server.transport]
type = "noise"

[server.transport.noise]
local_private_key = "<NOISE_PRIVATE_KEY>"

[server.services.jellyfin]
type = "tcp"
bind_addr = "0.0.0.0:8096"
