# ==============================================================================
# Caddyfile - Configuração do Proxy Reverso
# Homelab Services: Gateway / Reverse Proxy (LXC harden @ 10.10.10.27)
# ==============================================================================

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES GLOBAIS
# ------------------------------------------------------------------------------
{
    # Descomente e informe seu e-mail para notificações do Let's Encrypt / ZeroSSL:
    # email seu-email@exemplo.com

    # Formato e nível dos logs na saída padrão do container:
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# 1. ACESSO LOCAL / TESTE DIRETO POR IP (Sem HTTPS)
# Útil para testar a comunicação entre o Caddy e o Jellyfin na rede interna.
# ------------------------------------------------------------------------------
:80 {
    # Encaminha as requisições HTTP para a porta do Jellyfin no host 10.10.10.2:
    reverse_proxy 10.10.10.139:3545 {
        # Repassa os cabeçalhos de identificação do cliente original:
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ------------------------------------------------------------------------------
# 2. ACESSO LOCAL VIA NOME DNS (Technitium: jellyfin.home.lan -> 10.10.10.27)
# Permite abrir http://jellyfin.home.lan ou https://jellyfin.home.lan na porta 80/443 padrão
# ------------------------------------------------------------------------------
jellyfin.home.lan {
    reverse_proxy 10.10.10.139:3545
    tls internal  # Emite certificado TLS local automaticamente
}

transmission.home.lan {
    reverse_proxy 10.10.10.140:7777
    tls internal
}

pyload.home.lan {
    reverse_proxy 10.10.10.140:5000
    tls internal
}

dns01.home.lan {
    # Technitium escuta em HTTPS na porta 53443 com certificado autoassinado:
    reverse_proxy https://10.10.10.25:53443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
    tls internal
}

dns02.home.lan {
    reverse_proxy https://10.10.10.26:53443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
    tls internal
}

soyoz.home.lan {
    # Proxmox opera nativamente em HTTPS com certificado autoassinado:
    reverse_proxy https://10.10.10.5:8006 {
        transport http {
            tls_insecure_skip_verify
        }
    }
    tls internal
}



# ------------------------------------------------------------------------------
# 3. ACESSO EXTERNO SEGURO (HTTPS Automático via Let's Encrypt / Domínio Público)
# Para ativar o acesso público com certificado SSL automático:
# 1. Aponte seu domínio/DDNS (ex: jellyfin.meudominio.com ou meujellyfin.duckdns.org) para o seu IP público.
# 2. Descomente o bloco abaixo e substitua "jellyfin.meudominio.com.br" pelo seu domínio.
# ------------------------------------------------------------------------------
# jellyfin.meudominio.com.br {
#     # Proxy reverso otimizado para o Jellyfin:
#     reverse_proxy 10.10.10.139:3545 {
#         # Suporte a WebSockets para sincronização de reprodução em tempo real:
#         header_up Host {upstream_hostport}
#         header_up X-Real-IP {remote_host}
#         header_up X-Forwarded-For {remote_host}
#         header_up X-Forwarded-Proto {scheme}
#
#         # Otimização de buffer de transporte para streaming de vídeo:
#         transport http {
#             read_buffer 8192
#         }
#     }
# }
