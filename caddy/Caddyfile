# ==============================================================================
# Caddyfile - Configuração do Proxy Reverso + CrowdSec WAF
# Homelab Services: Gateway / Reverse Proxy (LXC harden @ 10.10.10.27)
# ==============================================================================

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES GLOBAIS
# ------------------------------------------------------------------------------
{
    # Desativa o redirecionamento automático forçado de HTTP para HTTPS:
    auto_https disable_redirects

    # Configuração global do CrowdSec Bouncer (bloqueio em tempo real via LAPI):
    crowdsec {
        api_url http://crowdsec:8080
        api_key {$CROWDSEC_API_KEY}
        ticker_interval 15s
    }

    # Formato e nível dos logs na saída padrão do container:
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# SNIPPET: PROTEÇÃO EM TEMPO REAL + LOGS FORMATADOS EM JSON PARA O CROWDSEC
# ------------------------------------------------------------------------------
(crowdsec_protect) {
    crowdsec
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 3
        }
        format json
    }
}

# ------------------------------------------------------------------------------
# 1. ACESSO LOCAL / TESTE DIRETO POR IP (Sem HTTPS)
# ------------------------------------------------------------------------------
:80 {
    import crowdsec_protect
    reverse_proxy 10.10.10.139:3545
}

# ------------------------------------------------------------------------------
# 2. SERVIÇOS DO HOMELAB (.home.lan)
# ------------------------------------------------------------------------------
http://jellyfin.home.lan {
    import crowdsec_protect
    reverse_proxy 10.10.10.139:3545
}

https://jellyfin.home.lan {
    import crowdsec_protect
    reverse_proxy 10.10.10.139:3545
    tls internal
}

transmission.home.lan {
    import crowdsec_protect
    reverse_proxy 10.10.10.140:7777
    tls internal
}

pyload.home.lan {
    import crowdsec_protect
    reverse_proxy 10.10.10.140:5000
    tls internal
}

dns01.home.lan {
    import crowdsec_protect
    reverse_proxy https://10.10.10.25:53443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
    tls internal
}

dns02.home.lan {
    import crowdsec_protect
    reverse_proxy https://10.10.10.26:53443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
    tls internal
}

sharecenter.home.lan {
    import crowdsec_protect
    reverse_proxy 10.10.10.10:80
    tls internal
}

soyoz.home.lan {
    import crowdsec_protect
    reverse_proxy https://10.10.10.5:8006 {
        transport http {
            tls_insecure_skip_verify
        }
    }
    tls internal
}

