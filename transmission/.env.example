USER=juca
PASS=insira_sua_senha_aqui

# ==============================================================================
# Configuração WireGuard do Gluetun (OCI Peer 10.66.66.2)
# ==============================================================================
# Chave pública do servidor OCI (obtida via 'sudo wg show wg0 public-key' na OCI)
WIREGUARD_SERVER_PUBLIC_KEY=<CHAVE_PUBLICA_SERVIDOR_OCI>

# Chave privada do cliente Gluetun (definida em /etc/wireguard/clients/gluetun.conf na OCI)
WIREGUARD_PRIVATE_KEY=<CHAVE_PRIVADA_GLUETUN>
